# Public URL
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Database: pooled URL for application runtime, direct URL for Prisma CLI/migrations
DATABASE_URL=
DIRECT_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
# Public username without @; must end in bot
TELEGRAM_BOT_USERNAME=your_yori_bot
# 32-256 characters: A-Z, a-z, 0-9, _ or -
TELEGRAM_WEBHOOK_SECRET=
# Keep as a string; groups and channels normally have a negative ID
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_SESSION_TTL_SECONDS=86400

# App access policy
ORDER_MODE=private_test
ALLOWED_TELEGRAM_USER_IDS=

# Administrator
AUTH_SECRET=
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
